# ==========================================
# تكية بهية — Git Ignore Rules
# ==========================================

# 1. البيئة والمتغيرات السرية (Environment & Secrets)
.env
.env.local
.env.*.local
.env.production
.env.development
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.*

# 2. حزم التبعيات (Dependencies)
node_modules/
**/node_modules/
vendor/
**/vendor/

# 3. مخرجات البناء والملفات المؤقتة (Build & Temp Files)
dist/
dist-ssr/
build/
.cache/
.vite/
.vite-temp/
*.tmp
*.temp
tmp/
temp/

# 4. ملفات السجلات (Logs)
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
error_log

# 5. النسخ الاحتياطية وملفات قواعد البيانات المؤقتة (Backups & DB Dumps)
*.sql.bak
*.bak
*.backup
*.dump
backup/
backups/
*.zip
*.tar.gz
*.rar

# 6. ملفات المحررات وأنظمة التشغيل (IDE & OS Files)
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
